        //                   sh 'terraform ${params.action} --auto-approve'
        //               }
                      
        //         }
        //     }
        // }
    }
}    









 pipeline for Debug  =====> 


pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'us-east-1'
        CLUSTER_NAME          = 'eks-cluster-terraform'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/main']],
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'git-cred',
                        url: 'https://github.com/Jagdeep786-ctrl/terraform-jenkins-eks.git'
                    ]]
                )
            }
        }



        stage('Debug ALB Controller') {
            steps {
                sh '''
                    set +e

                    echo "================ NAMESPACES ================"
                    kubectl get ns

                    echo "================ KUBE-SYSTEM PODS ================"
                    kubectl get pods -n kube-system -o wide

                    echo "================ ALB CONTROLLER DEPLOYMENT ================"
                    kubectl get deployment -n kube-system aws-load-balancer-controller
                    kubectl describe deployment -n kube-system aws-load-balancer-controller

                    echo "================ ALB CONTROLLER SERVICE ACCOUNT ================"
                    kubectl get sa aws-load-balancer-controller -n kube-system -o yaml

                    echo "================ ALB CONTROLLER POD NAMES ================"
                    kubectl get pods -n kube-system | grep aws-load-balancer-controller || true

                    POD1=$(kubectl get pods -n kube-system | awk '/aws-load-balancer-controller/ {print $1}' | sed -n '1p')
                    POD2=$(kubectl get pods -n kube-system | awk '/aws-load-balancer-controller/ {print $1}' | sed -n '2p')

                    echo "POD1=$POD1"
                    echo "POD2=$POD2"

                    if [ -n "$POD1" ]; then
                      echo "================ DESCRIBE POD1 ================"
                      kubectl describe pod -n kube-system "$POD1"

                      echo "================ POD1 CURRENT LOGS ================"
                      kubectl logs -n kube-system "$POD1" || true

                      echo "================ POD1 PREVIOUS LOGS ================"
                      kubectl logs -n kube-system "$POD1" --previous || true
                    fi

                    if [ -n "$POD2" ]; then
                      echo "================ DESCRIBE POD2 ================"
                      kubectl describe pod -n kube-system "$POD2"

                      echo "================ POD2 CURRENT LOGS ================"
                      kubectl logs -n kube-system "$POD2" || true

                      echo "================ POD2 PREVIOUS LOGS ================"
                      kubectl logs -n kube-system "$POD2" --previous || true
                    fi

                    echo "================ KUBE-SYSTEM EVENTS ================"
                    kubectl get events -n kube-system --sort-by=.metadata.creationTimestamp || true
                '''
            }
        }
    }
}